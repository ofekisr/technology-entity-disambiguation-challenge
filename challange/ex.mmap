                    {
                      "topic": "Q17. Size: does it fit in memory?",
                      "id": "a0bda78a68f5acfe",
                      "note": "Estimate 22-10-26, not measured. Per-row sizes are rough.",
                      "children": [
                        {
                          "topic": "Entities 100K-300K x 3-10 aliases -> 0.3M-3M aliases",
                          "id": "cad20515f831ac38"
                        },
                        {
                          "topic": "Python dict ~200B/row -> 60-600MB (upper bound borderline)",
                          "id": "2ec75e7e7d63c6b4"
                        },
                        {
                          "topic": "Node Map ~100B/row -> 30-300MB; FST ~5-50MB; inverted index ~3-30MB",
                          "id": "07410cf551932e1d"
                        },
                        {
                          "topic": "Fallback: Postgres btree on alias_norm (~1ms) + Bloom filter in memory + LRU",
                          "id": "7641eaa7dd3c5491"
                        },
                        {
                          "topic": "↻ → D-35 · Measure after first build: alias count, RSS after load, load time",
                          "id": "614f59ba1b6cf3e8"
                        }
                      ],
