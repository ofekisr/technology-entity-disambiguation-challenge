                        {
                          "topic": "Q11. Sub-vendors, brands, acquisitions",
                          "id": "64aa08c1d4f3d492",
                          "note": "Cases where the product's vendor sits under another company. Same pattern for brands and acquisitions.",
                          "style": {
                            "fontSize": "20px"
                          },
                          "children": [
                            {
                              "topic": "Real cases",
                              "id": "78d42061ab967c5c",
                              "children": [
                                {
                                  "topic": "AWS ⊂ Amazon",
                                  "id": "2647fee96035d271",
                                  "note": "📊 CPE splits it: vendor amazon (107 products, incl. amazon:aws_lambda) vs vendor aws (3)."
                                },
                                {
                                  "topic": "Nginx ⊂ F5",
                                  "id": "05c2a73a2cb432cc",
                                  "note": "📊 webappanalyzer maps Nginx → cpe:2.3:a:f5:nginx. Market still says 'Nginx'."
                                },
                                {
                                  "topic": "SafeNet → Gemalto → Thales",
                                  "id": "2c1255edcf594194",
                                  "note": "📊 Acquisition chain in CPE, all with 'sentinel' products."
                                },
                                {
                                  "topic": "NetIQ → Micro Focus",
                                  "id": "90ca74928f08cf4b",
                                  "note": "📊 Seen in CPE vendor analysis."
                                },
                                {
                                  "topic": "GitHub ⊂ Microsoft, VMware ⊂ Broadcom, Mandiant ⊂ Google, Red Hat ⊂ IBM",
                                  "id": "54bea7380e09e01d",
                                  "note": "From general knowledge, not checked against CPE."
                                }
                              ],
                              "expanded": false
                            },
                            {
                              "topic": "Modeling options",
                              "id": "400c7384691b1afd",
                              "children": [
                                {
                                  "topic": "⭐ A. vendors.parent_vendor_id + relation",
                                  "id": "767654f9ecc95bc6",
                                  "note": "relation ∈ subsidiary | brand | acquired | division, optional since (date). Tree, depth ≤ 3, no cycles (validate)."
                                },
                                {
                                  "topic": "B. Separate brands table (vendor → brands)",
                                  "id": "9c3388d184e9a6a4",
                                  "note": "More tables, same expressiveness. Only if brands need their own attributes."
                                },
                                {
                                  "topic": "✗ C. Collapse to the ultimate parent",
                                  "id": "d155551bf72b432e",
                                  "note": "'Microsoft GitHub Copilot', 'Broadcom ESXi': loses the names reports actually use, merges unrelated portfolios."
                                }
                              ],
                              "expanded": false
                            },
                            {
                              "topic": "⭐ Canonical vendor = the operating brand the market uses",
                              "id": "6272e24761dd4fe2",
                              "note": "AWS EKS (not Amazon EKS), GitHub Copilot, VMware ESXi. Parent appears only in the vendor table."
                            },
                            {
                              "topic": "⭐ Acquisition never changes the ID",
                              "id": "d78b42c26ccff224",
                              "note": "vmware/esxi stays. vendor gets a parent; old names stay aliases; 'Broadcom VMware ESXi' comes from parent × product alias rule."
                            },
                            {
                              "topic": "Resolve rules",
                              "id": "395aaac816d2b1f5",
                              "children": [
                                {
                                  "topic": "Vendor token → own products first, then descendants (confidence penalty)",
                                  "id": "5a06f0d2dc840ca2",
                                  "note": "'Amazon EKS' → amazon → descendant aws → AWS EKS ✅"
                                },
                                {
                                  "topic": "Never search ancestors' products from a child token",
                                  "id": "8b6428252ef8e99e",
                                  "note": "'AWS Alexa' must not resolve to Amazon Alexa."
                                },
                                {
                                  "topic": "Own product beats descendant's",
                                  "id": "9a9f1a2abf39d610",
                                  "note": "'Microsoft Copilot' ≠ 'GitHub Copilot'."
                                },
                                {
                                  "topic": "Category is not inherited from parent",
                                  "id": "0e43cb7583f6ab67",
                                  "note": "Amazon retail ≠ AWS cloud."
                                }
                              ],
                              "expanded": false
                            },
                            {
                              "topic": "❓ 'AWS' = vendor or the cloud platform?",
                              "id": "47c2aea41f4f9b73",
                              "note": "Proposal: two entities, vendor aws and product aws/aws (cloud-platform). A vendor-like input resolves to the flagship platform when one exists; 'Microsoft' (no platform) → vendor entity."
                            },
                            {
                              "topic": "❓ 'Amazon' vs 'AWS': hard negative?",
                              "id": "e52fb67f1cc720e4",
                              "note": "Proposal: yes, distinct entities; parent link is metadata, not equality."
                            },
                            {
                              "topic": "Sources for the hierarchy",
                              "id": "910ad7aa3d36b8ba",
                              "children": [
                                {
                                  "topic": "Wikidata P749 parent organization / P355 subsidiary / P127 owned by",
                                  "id": "833afeeca78fc2f2",
                                  "note": "Not queried (blocked here) [CONFIRM]."
                                },
                                {
                                  "topic": "CPE evidence: products filed under another vendor",
                                  "id": "ad8ded2782636f62",
                                  "note": "f5:nginx, amazon:aws_*; dup-vendor groups."
                                },
