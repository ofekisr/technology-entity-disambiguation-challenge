        {
          "topic": "Design",
          "id": "e72c61cbb43042b9",
          "children": [
            {
              "topic": "V3 (locked, 22-10-26)",
              "id": "531043fc89a19719",
              "note": "Locked design. Every ⏳ from V2 is 🔒 decision (D-xx). Runtime = Python 3.12 (D-46). One item waits on Matan with a default (D-47). V1 and V2 untouched.",
              "children": [
                {
                  "topic": "1. Approach",
                  "id": "7243cbd26f17bbec",
                  "children": [
                    {
                      "topic": "Dictionary-first, deterministic resolve; no LLM / embeddings per request (D-01, D-23)",
                      "id": "8e3ccb38d1217459"
                    },
                    {
                      "topic": "Closed world: resolve only to catalog entities, never invent at runtime",
                      "id": "b1e9adb86d283190"
                    },
                    {
                      "topic": "Precision over recall; ambiguity returned with alternatives (D-14)",
                      "id": "16e5b6d1eb7a8ff0"
                    },
                    {
                      "topic": "🔒 Unknown input = no_match + review queue; closed world (D-47) [WAITING ON MATAN, default locked]",
                      "id": "4bdf643e6c976260"
                    },
                    {
                      "topic": "🔒 Implementation: Python 3.12, pytest + hypothesis, rapidfuzz, sqlite3, Pydantic at boundaries (D-46)",
                      "id": "11da933a08a85f3e"
                    }
                  ],
                  "expanded": true
                },
                {
                  "topic": "2. High-level flows",
                  "id": "da1e46adb7359405",
                  "note": "Ofek's framing: Phase 0 builds a versioned index; runtime queries it; offline API makes new versions; real-time updates are restricted so earlier responses never change.",
                  "children": [
                    {
                      "topic": "Flow A: Build (offline)",
                      "id": "fa520e88073f7c6d",
                      "note": "sources -> pipeline -> validate -> eval gate -> replay ledger -> publish immutable snapshot vN"
                    },
                    {
                      "topic": "Flow B: Resolve (runtime)",
                      "id": "9f5bcd1519fa23e2",
                      "note": "normalize -> LRU -> ledger -> overlay + snapshot -> algorithm -> response + ledger record"
                    },
                    {
                      "topic": "Flow C: Offline update API -> vN+1",
                      "id": "c112d7d302aa5801",
                      "note": "Mutations / plugin proposals -> changeset -> review -> Flow A. Any change allowed; replay lists every changed response."
                    },
                    {
                      "topic": "Flow D: Real-time update (restricted)",
                      "id": "d07fbda4c1a72bcf",
                      "note": "Append-only overlay, exact matches only. Admission: safe change type, new alias key only, ledger replay shows no changed answer."
                    },
                    {
                      "topic": "🔒 Inside one version: improve-only, no_match -> resolved allowed, resolved never changes (D-31)",
                      "id": "b2d26ceb8a0736ac"
                    },
                    {
                      "topic": "🔒 Ledger key includes index_version; replay diff is the gate (D-31)",
                      "id": "87e65750dbbe3256"
                    },
                    {
                      "topic": "🔒 Flow D = doc only; if built, index_version = snapshot_hash + overlay_seq (D-43)",
                      "id": "4a3a70cc4a38ae63"
                    }
                  ],
                  "expanded": false
                },
                {
                  "topic": "3. Canonical & IDs",
                  "id": "544cb2c4ee60c14b",
                  "children": [
                    {
                      "topic": "Display: Vendor + Product, official casing",
                      "id": "e6edaaf249ffb910"
                    },
                    {
                      "topic": "ID: vendor/product slug (CPE WFN rules), immutable; rename -> alias; merge -> redirect",
                      "id": "37f79f1d14f9fc24"
                    },
                    {
                      "topic": "Canonical vendor = operating brand; parent_vendor_id; IDs survive acquisitions (D-11)",
                      "id": "3c492ccc107258a5"
                    },
                    {
                      "topic": "CPE is the ID backbone; display names from manual / Wikidata (D-02)",
                      "id": "f0f2df089f15a6da"
                    },
                    {
                      "topic": "🔒 'AWS' = vendor aws + product aws/aws; flagship_entity_id; Amazon != AWS (D-32)",
                      "id": "4f079a018eea5fa3"
                    },
                    {
                      "topic": "🔒 manual > Wikidata > CPE title > slug; '<Vendor> <Product>', symbols kept (D-33)",
                      "id": "66b8d3a09fd31feb"
                    }
                  ],
                  "expanded": false
                },
                {
                  "topic": "4. Index model",
                  "id": "d801324dc78c89de",
                  "children": [
                    {
                      "topic": "Tables: categories, vendors, entities, aliases, vendor_aliases (parent_id trees)",
                      "id": "10cbec6d8a253aca"
                    },
                    {
                      "topic": "Invariants checked by validate(): immutable IDs, strong alias -> 1 entity, no cycles, every entity has a category",
                      "id": "a5679235bc41c6da"
                    },
                    {
                      "topic": "Child never equals parent: parent_id + validator (D-10)",
                      "id": "331599b0f0370897"
                    },
                    {
                      "topic": "Product-only and <=3-char aliases weak; alias -> >1 entity = ambiguous (D-09)",
                      "id": "17d556959bd08970"
                    },
                    {
                      "topic": "Own 2-level category list; one primary; 'vendor' is a category; uncategorized never filtered (D-05, D-06)",
                      "id": "30025d0e9a7a3440"
                    },
                    {
                      "topic": "🔒 categories.yaml v1 = 23 leaves; tier-1 100% coverage (D-34)",
                      "id": "cc716398c4fca4fb"
                    },
                    {
                      "topic": "🔒 One SQLite snapshot + exact-alias dict; measure at build; >=1M -> SQLite lookups (D-35)",
                      "id": "74f0e02161ee8cfe"
                    }
                  ],
                  "expanded": false
                },
                {
                  "topic": "5. Build pipeline",
                  "id": "dcc7f7ade8af6acd",
                  "children": [
                    {
                      "topic": "Stages: ingest -> create canonicals -> merge (hard IDs) -> category -> aliases -> validate -> token/IDF index -> eval gate -> publish",
                      "id": "ed1ee18e8634e250"
                    },
                    {
                      "topic": "Creators: CPE + manual + whitelisted; others enrich only (D-03)",
                      "id": "4a1725fa10714175"
                    },
                    {
                      "topic": "Merge only on hard IDs; similarity -> review (D-04)",
                      "id": "70426aa65a4ba4ff"
                    },
                    {
                      "topic": "Semantic variants built as aliases; runtime normalization mechanical (D-07)",
                      "id": "73b217f241c90d5a"
                    },
                    {
                      "topic": "No auto-initials; curated acronym table (D-08)",
                      "id": "85feaf1740252a63"
                    },
                    {
                      "topic": "IDF, thresholds, calibration table frozen inside the snapshot",
                      "id": "455e6ecb1e99bd4c"
                    },
                    {
                      "topic": "Source of truth = files in git; snapshot SQLite / in-memory; index_version = content hash (D-12)",
                      "id": "4515adcc46ac6beb"
                    },
                    {
                      "topic": "Enrichment plugins (D-24)",
                      "id": "21a3df1f54296d89",
                      "children": [
                        {
                          "topic": "Plugins only propose (changesets); never write the index",
                          "id": "8e7819a8096c066b"
                        },
                        {
                          "topic": "Port EnrichmentPlugin.propose(scope, snapshotView) -> Proposal[]; adapters per source",
                          "id": "a045195aeab9e784"
                        },
                        {
                          "topic": "Manifest: id, version (incl. model + prompt hash), kind, capabilities, maxStrength",
                          "id": "e7bdadc1bba174b0"
                        },
                        {
                          "topic": "Only deterministic plugins run inside build; external / llm run in 'idx propose'",
                          "id": "585a9933afd1afc0"
                        },
                        {
                          "topic": "Zero plugins = valid build; plugins.yaml enables each one",
                          "id": "e147b89368d28851"
                        },
                        {
                          "topic": "LLM proposals: status=proposed, strength <= weak until reviewed",
                          "id": "db591d6adb863fad"
                        },
                        {
                          "topic": "🔒 Auto-approve only deterministic + validate() + eval gate (D-37)",
                          "id": "f9f74c8a9f09fb41"
                        },
                        {
                          "topic": "🔒 proposals/<plugin_id>/<YYYY-MM-DD>.jsonl (D-37)",
                          "id": "07f5b7d02c497354"
                        },
                        {
                          "topic": "🔒 Manifest pins model + prompt hash; cost cap $5/run, to calibrate (D-37)",
                          "id": "8619b60fe40e3275"
                        }
                      ],
                      "expanded": false
                    },
                    {
                      "topic": "🔒 Build emits denormalized aliases: parent-vendor x product, category-label x product (D-44)",
                      "id": "91c8cadb64278393"
                    },
                    {
                      "topic": "🔒 CPE parts a + o; deprecatedBy -> alias; tier 1/2/3 manual (D-41)",
                      "id": "c32d3b0e3efe8b5a"
                    }
                  ],
                  "expanded": false
                },
                {
                  "topic": "6. Resolve flow",
                  "id": "fd05140b3a219065",
                  "children": [
                    {
                      "topic": "normalize -> LRU -> ledger -> exact alias -> decompose -> candidates -> score -> decide -> record",
                      "id": "ca78c33c6dd4e366"
                    },
                    {
                      "topic": "Ledger (durable) + hot LRU seeded from ledger top-N (D-17)",
                      "id": "7c11a3b4870ac5ff",
                      "note": "Key = (input_norm, filters, hints, index_version)."
                    },
                    {
                      "topic": "Request: name + hints (soft) + filters (hard, includeUncategorized=true) (D-18)",
                      "id": "17f4ca6f45e705d2"
                    },
                    {
                      "topic": "Vendor in the input = inferred hint (D-19)",
                      "id": "a13821f5bdda4ffd"
                    },
                    {
                      "topic": "Candidates: inverted token index, IDF, trigram typo fix (D-20)",
                      "id": "bf4fd7dec6fa8115"
                    },
                    {
                      "topic": "Score: IDF token-set Jaccard + coverage penalty; base by match type (D-21)",
                      "id": "c3e25b9162bbcb3d"
                    },
                    {
                      "topic": "Decide on (s1, margin); prior = tie-break; calibrated conf (D-22)",
                      "id": "3fdc821ab5065576"
                    },
                    {
                      "topic": "Sub-vendor rules: own products first, then descendants; never ancestors",
                      "id": "4d545e2a7eb58723"
                    },
                    {
                      "topic": "Tie-break (score desc, entity_id asc) (D-16)",
                      "id": "2491a7384de326dc"
                    },
                    {
                      "topic": "Output: { id, canonical_name, vendor, category, confidence, status, alternatives[], index_version }",
                      "id": "dec67c4af80ae92a"
                    },
                    {
                      "topic": "🔒 T_high 0.75, T_low 0.5, M 0.15, K 20, to calibrate (D-28)",
                      "id": "05925e66f5652178"
                    },
                    {
                      "topic": "🔒 +0.15 additive; exact strong hit ignores hints; never lowers (D-29)",
                      "id": "5a1c54e8559b3bd2"
                    },
                    {
                      "topic": "🔒 lru_cache(10_000); ledger = Protocol stub in code; seed top-1,000 in prod (D-30)",
                      "id": "665e7c7535965335"
                    },
                    {
                      "topic": "🔒 Typo rule: trigram candidates + Levenshtein <= 2; JW dropped (D-26)",
                      "id": "ad78a315fdd2a671"
                    },
                    {
                      "topic": "🔒 Base by match type 1.0 / 0.97 / 0.9 / 0.8 weak-unique / fuzzy = score (D-27)",
                      "id": "2db383ecfccbab04"
                    },
                    {
                      "topic": "🔒 Runtime decompose = vendor longest-prefix only; no tree walk, no category inference (D-44)",
                      "id": "507bbafc4bac5b30"
                    },
                    {
                      "topic": "🔒 Interface: resolve(name, *, hints=None, filters=None) -> Resolution (D-18 kept, optional kwargs)",
                      "id": "22f4a156e7bc75b8"
                    }
                  ],
                  "expanded": false
                },
                {
                  "topic": "7. Update API",
                  "id": "1256803b1d44aa8d",
                  "children": [
                    {
                      "topic": "Mutations: upsert_entity, deprecate_entity, upsert_vendor, add/remove alias, mark_ambiguous, set_category, propose",
                      "id": "02d7f8556eab4436"
                    },
                    {
                      "topic": "Git files + CLI; PR = review; changesets carry provenance (D-13)",
                      "id": "7e0d3dc483446d74"
                    },
                    {
                      "topic": "validate -> build -> replay/diff -> evaluate -> publish (atomic); rollback",
                      "id": "bf9b5f319bb7a4fc"
                    },
                    {
                      "topic": "🔒 Upsert idempotent; provenance source/actor/added_at/reason/evidence_url; PR reviewer approves; atomic swap (D-36)",
                      "id": "2f25478e3a782c05"
                    },
                    {
                      "topic": "🔒 Code: one file per table; per-vendor split = doc only (D-42)",
                      "id": "4a4ad8efa81f572a"
                    }
                  ],
                  "expanded": false
                },
                {
                  "topic": "8. Evaluation",
                  "id": "c4f5a5c5b16b9962",
                  "children": [
                    {
                      "topic": "Gold set, 5 types: exact, near-collision, hard negative, typo, unknown",
                      "id": "495ea823ce47bf2a"
                    },
                    {
                      "topic": "Sources: hand-labeled, leave-one-out, synthetic perturbations, KEV, deprecatedBy",
                      "id": "3e2d69612290db61"
                    },
                    {
                      "topic": "Dev / test split; threshold sweep; calibration (ECE); ablation",
                      "id": "81b8f898f35edfba"
