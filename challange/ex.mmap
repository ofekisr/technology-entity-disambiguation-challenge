                      "note": "Copied from Design V1."
                    },
                    {
                      "topic": "Decision rules",
                      "id": "3dc3092369203d97",
                      "children": [
                        {
                          "topic": "Exact match: confidence 1.0",
                          "id": "7fb328a39325e058"
                        },
                        {
                          "topic": "Vendor token present: prefer vendor+product",
                          "id": "5b5fdaaf62d510b5"
                        },
                        {
                          "topic": "Product-only, many vendors: ambiguous, return null + candidates",
                          "id": "125d26fe10d438dd"
                        },
                        {
                          "topic": "Child never collapses to parent",
                          "id": "77113965320a45f8",
                          "children": [
                            {
                              "topic": "Amazon Web Services ≠ AWS EKS",
                              "id": "844e32331a50804f"
                            },
                            {
                              "topic": "Sentinel vs Microsoft Sentinel",
                              "id": "b4d19629d189ccb7"
                            }
                          ],
                          "expanded": false
                        },
                        {
                          "topic": "Below threshold: no match, queue for review",
                          "id": "0678bd4c541eda93"
                        }
                      ],
                      "expanded": false,
                      "note": "Copied from Design V1."
                    },
                    {
                      "topic": "Sub-vendor resolve rules",
                      "id": "2de7d47fe626b2c9",
                      "children": [
                        {
                          "topic": "Vendor token → own products first, then descendants (confidence penalty)",
                          "id": "3f99c1ede357e7d2",
                          "note": "'Amazon EKS' → amazon → descendant aws → AWS EKS ✅"
                        },
                        {
                          "topic": "Never search ancestors' products from a child token",
                          "id": "b6e2b7256a2d52dd",
                          "note": "'AWS Alexa' must not resolve to Amazon Alexa."
                        },
                        {
                          "topic": "Own product beats descendant's",
                          "id": "b34c0d318a8ec332",
                          "note": "'Microsoft Copilot' ≠ 'GitHub Copilot'."
                        },
                        {
                          "topic": "Category is not inherited from parent",
                          "id": "baace982b8bca5b1",
                          "note": "Amazon retail ≠ AWS cloud."
                        }
                      ],
                      "note": "Copied from Q11.",
                      "expanded": false
                    },
                    {
                      "topic": "Fuzzy guardrails",
                      "id": "597d01d6464ef744",
                      "note": "token-set + IDF; Levenshtein ≤ 2 (📄 Sanguino); ≤ 3 chars exact only; Jaro-Winkler for typos [❓ threshold]. ↻ → D-26: one typo rule, JW dropped."
                    },
                    {
                      "topic": "Output",
