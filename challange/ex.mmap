                      "topic": "Runtime & cost (evidence)",
                      "id": "359fa37be51d37c8",
                      "children": [
                        {
                          "topic": "💡 Build output = one SQLite file: alias table + FTS5 token index",
                          "id": "74fa74c9c1936078",
                          "note": "Same artifact runs in-process locally and on Cloudflare D1 (~$0.30 per 1M requests incl. Worker). Covers exact lookup + candidate retrieval in one file. index_version = file hash."
                        },
                        {
                          "topic": "💲 In-memory map is the cheapest runtime (~78k entities fits); KV only for exact match",
                          "id": "71c467d2468baaee"
                        },
                        {
                          "topic": "💲 Vectorize ~$3.84 per 1M (384 dims) → embeddings can't be per-request → offline / fallback only",
                          "id": "fbc6bc90d48f53f5",
                          "note": "Backs V1 'RAG offline only'."
                        }
