                      "note": "{ id, canonical_name, vendor, category, confidence, status: resolved|ambiguous|no_match, alternatives[], index_version } — fields mirror OCSF product (vendor_name, name, cpe_name)."
                    },
                    {
                      "topic": "V1 sketch: Calling the Index",
                      "id": "9a984df62ad36c50",
                      "children": [
                        {
                          "topic": "optimizations",
                          "id": "64a689af4f878404",
                          "children": [
                            {
                              "topic": "Partitions by A–Z",
                              "id": "851148ff6df37638",
